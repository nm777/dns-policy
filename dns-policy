192.0.2.6,00:00:00:00:00:66,200,duplicate-one,0,7
192.0.2.7,00:00:00:00:00:66,200,duplicate-two,0,7
192.0.2.9,00:00:00:00:00:99,200,mismatch,0,7
192.0.2.11,00:00:00:00:00:11,200,bypassed-unreserved,0,7
"""
    current = header + """192.0.2.1,00:00:00:00:00:01,200,"new,name.",0,7
192.0.2.1,00:00:00:00:00:01,200,"new,name.",0,7
192.0.2.4,00:00:00:00:00:04,200,trailing.,1,7
"""
    leases = replay_leases((("baseline", baseline.encode()), ("current", current.encode())), now=100)
    assert set(leases) == {"192.0.2.1", "192.0.2.5", "192.0.2.6", "192.0.2.7", "192.0.2.9", "192.0.2.11"}
    assert leases["192.0.2.1"]["hostname"] == "new,name"
