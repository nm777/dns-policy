    print("internal checks passed")


def main(argv):
    if argv[:1] == ["--install-kea-reservation"]:
        if len(argv) != 4:
            raise PolicyError("invalid internal reservation installation arguments")
        if os.geteuid() != 0:
            raise PolicyError("internal reservation installation requires EUID 0")
        return install_kea_reservation(*argv[1:])
    if os.geteuid() == 0 and argv != ["--self-check"]:
        raise PolicyError("run dns-policy without sudo to avoid root-owned policy state; reserve requests sudo when needed")
    if argv == ["reserve"]:
        return reserve_interactive(sys.stdin, sys.stdout)

    list_protected = False
    interactive = False
    interactive_target = False
    interactive_protect = False
    expected_entries = expected_generation = expected_ip = None
    interactive_type = None
    if argv == ["--self-check"]:
        self_check()
        return 0
    if argv == ["list"]:
        action, target, value = "list", None, None
    elif argv == ["list", "--protected"]:
        action, target, value = "list", None, None
        list_protected = True
    elif argv == ["bypass"]:
        require_tty(sys.stdin, sys.stdout)
        interactive_type = prompt_policy_type(sys.stdin, sys.stdout)
        action, target, value = "bypass", None, None
        interactive = True
    elif len(argv) == 2 and argv[0] == "bypass":
        require_tty(sys.stdin, sys.stdout)
        initial_records = reservations()
        _, expected_ip = resolve_device(argv[1], initial_records)
        try:
            expected_entries, expected_generation, expected_pruned = parse_state(STATE.read_bytes())
        except OSError as error:
            raise PolicyError(f"cannot read policy state {STATE}: {error}") from error
        if expected_pruned:
            raise PolicyError("interactive bypass requires current policy state; run dns-policy list first")
        require_synchronized(expected_entries, expected_generation)
        action, target, value = "bypass", argv[1], prompt_minutes(sys.stdin, sys.stdout)
        interactive_target = True
    elif argv == ["protect"]:
        require_tty(sys.stdin, sys.stdout, "protect")
        action, target, value = "protect", None, None
        interactive_protect = True
    elif len(argv) == 2 and argv[0] == "protect":
        action, target, value = "protect", argv[1], None
    elif len(argv) == 3 and argv[0] == "bypass" and argv[2] == "--permanent":
        action, target, value = "bypass", argv[1], None
    elif len(argv) == 4 and argv[0] == "bypass" and argv[2] == "--for":
        action, target, value = "bypass", argv[1], duration(argv[3])
    else:
        usage()
        return 2

    os.chmod(POLICY_DIR, 0o700)
    lock_fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.fchmod(lock_fd, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        records = reservations()
        try:
            entries, generation, pruned = parse_state(STATE.read_bytes())
        except OSError as error:
            raise PolicyError(f"cannot read policy state {STATE}: {error}") from error
        if action == "list":
            if pruned:
                generation = persist_and_apply(entries)
            leases = active_leases() if list_protected else None
            return list_policy(entries, generation, records, list_protected, leases)
        if interactive:
            if pruned:
                raise PolicyError("interactive bypass requires current policy state; run dns-policy list first")
            require_synchronized(entries, generation)
            inventory = protected_inventory(entries, records, active_leases())
            if not inventory:
                raise PolicyError("no desired-protected devices are available")
            print_interactive_inventory(inventory, sys.stdout)
            selected = inventory[prompt_selection(len(inventory), sys.stdin, sys.stdout)]
            if selected["kind"] == "unreserved":
                raise PolicyError(
                    f"fixed Kea reservation required for {selected['hostname']} "
                    f"({selected['ip']}, {selected['mac']}); refusing unsafe IP-only policy"
                )
            if not selected["selectable"]:
                raise PolicyError(
                    f"selected reserved device {selected['hostname']} ({selected['ip']}, {selected['mac']}) "
                    f"is not selectable: {selected['status']}"
                )
            expiry = prompt_minutes(sys.stdin, sys.stdout) if interactive_type == "temporary" else None

            current_records = reservations()
            current_rows = protected_inventory(entries, current_records, active_leases())
            current = next((row for row in current_rows if row["ip"] == selected["ip"]), None)
            if not current or current["kind"] != "reserved" or not current["selectable"]:
                raise PolicyError("selected reservation or lease status changed; no policy was changed")
            name, ip = resolve_device(selected["ip"], current_records)
            try:
                current_entries, current_generation, current_pruned = parse_state(STATE.read_bytes())
            except OSError as error:
                raise PolicyError(f"cannot revalidate policy state {STATE}: {error}") from error
            if current_pruned or current_generation != generation or current_entries != entries:
                raise PolicyError("desired policy changed during interactive selection; no policy was changed")
            require_synchronized(entries, generation)
            entries[ip] = expiry
            if expiry is None:
                status = "permanent bypass"
            else:
                status = f"timed bypass for {remaining(max(0, expiry - int(time.time())))}"
        elif interactive_target:
            name, ip = resolve_device(target, records)
            if ip != expected_ip:
                raise PolicyError("selected reservation changed during interactive bypass; no policy was changed")
            if pruned or generation != expected_generation or entries != expected_entries:
                raise PolicyError("desired policy changed during interactive bypass; no policy was changed")
            require_synchronized(entries, generation)
            entries[ip] = value
            status = f"timed bypass for {remaining(max(0, value - int(time.time())))}"
        elif interactive_protect:
            if pruned:
                raise PolicyError("interactive protect requires current policy state; run dns-policy list first")
            require_synchronized(entries, generation, "protect")
            inventory = bypass_inventory(entries, records)
            if not inventory:
                raise PolicyError("no active desired bypass entries are available")
            print_bypass_inventory(inventory, sys.stdout)
            selected = inventory[prompt_selection(len(inventory), sys.stdin, sys.stdout, "protect")]
            name, ip, _, _, selected_value = selected
            try:
                current_entries, current_generation, current_pruned = parse_state(STATE.read_bytes())
            except OSError as error:
                raise PolicyError(f"cannot revalidate policy state {STATE}: {error}") from error
            if (
                current_pruned
                or current_generation != generation
                or current_entries != entries
                or ip not in current_entries
                or current_entries[ip] != selected_value
            ):
                raise PolicyError("desired policy changed during interactive protect selection; no policy was changed")
            require_synchronized(current_entries, current_generation, "protect")
            entries = current_entries
        else:
            name, ip = resolve_device(target, records)
        if action == "protect":
            entries.pop(ip, None)
            status = "protected"
        elif interactive or interactive_target:
            pass
        elif value is None:
            entries[ip] = None
            status = "permanent bypass"
        else:
            entries[ip] = int(time.time()) + value
            status = f"timed bypass for {remaining(value)}"
        generation = persist_and_apply(entries)
        if action == "bypass":
            print(
                "dns-policy: warning: bypass grant is effective only when the device uses DNS 192.168.0.91",
                file=sys.stderr,
            )
        message = f"{name} ({ip}): {status}; persisted and live generation {generation}"
        syslog.syslog(syslog.LOG_NOTICE, "dns-policy: " + message)
        print(message)
        return 0
    finally:
        os.close(lock_fd)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (PolicyError, OSError) as error:
        syslog.syslog(syslog.LOG_ERR, "dns-policy: " + str(error))
        print(f"dns-policy: error: {error}", file=sys.stderr)
        raise SystemExit(1)
