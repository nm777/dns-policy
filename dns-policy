def self_check():
    real_geteuid = os.geteuid
    try:
        os.geteuid = lambda: 0
        try:
            main(["bypass"])
        except PolicyError as error:
            assert "without sudo" in str(error), str(error)
        else:
            raise AssertionError("root policy invocation was accepted")
    finally:
        os.geteuid = real_geteuid

    assert duration("1s") == 1
    assert all(valid_hostname(value) for value in ("a", "host-1", "a" * 63))
    assert not any(valid_hostname(value) for value in ("", "Host", "-host", "host-", "a" * 64, "host_name"))
    assert private_mac("02:00:00:00:00:01") and not private_mac("00:00:00:00:00:01")

    class FakeSocket:
        def __enter__(self):
            return self

        def __exit__(self, *unused):
            pass

        def settimeout(self, unused):
            pass

        def connect(self, address):
            assert isinstance(address, str)

        def sendall(self, unused):
            pass

        def shutdown(self, unused):
            pass

        def recv(self, unused):
            return b'{"result":0}'

    real_socket = socket.socket
    try:
        socket.socket = lambda *unused: FakeSocket()
        kea_control_reload()
    finally:
        socket.socket = real_socket

    raw, generation = serialize({"192.0.2.1": None, "192.0.2.2": 2000000000})
    assert parse_state(raw, now=1) == ({"192.0.2.1": None, "192.0.2.2": 2000000000}, generation, False)
    try:
