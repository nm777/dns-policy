    output = io.StringIO()
    assert prompt_policy_type(io.StringIO("invalid\n\n"), output) == "temporary"
    assert prompt_policy_type(io.StringIO("P\n"), output) == "permanent"
    assert prompt_selection(2, io.StringIO("x\n0\n3\n2\n"), output) == 1
    assert prompt_minutes(io.StringIO("0\n1.5\n999999999999999999999999\n2\n"), output, now=100) == 220
